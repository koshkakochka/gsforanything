{
  // Cloudflare Worker "gs": https://gsforanything.com (+ www), with
  // https://gs.krossruiz.workers.dev kept on as a fallback (workers_dev).
  // Secrets (CLAUDE_API_KEY, OPENAI_API_KEY, ...) are stored in Cloudflare with
  // `wrangler secret put` and are NOT in this repo; deploys keep them.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gs",
  "main": "index.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  // Workers Custom Domains (Cloudflare creates the DNS records and certificates).
  "routes": [
    { "pattern": "gsforanything.com", "custom_domain": true },
    { "pattern": "www.gsforanything.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*", "/e/*", "/embed/*"]
  },
  "kv_namespaces": [
    {
      "binding": "SCENES",
      "id": "0e333b55e246449e9f97cb7e90d32f7a"
    }
  ],
  // Dev is a separate Worker (`gs-dev`) with its own KV namespace
  // (`gs-dev-scenes`). `routes` are inheritable, so they MUST be overridden
  // here: otherwise `wrangler deploy --env dev` would attach the production
  // custom domains to the dev Worker. The SCENES binding is not inheritable
  // and is pointed at the dev KV only — never the production id.
  "env": {
    "dev": {
      "name": "gs-dev",
      "workers_dev": true,
      "routes": [
        { "pattern": "dev.gsforanything.com", "custom_domain": true }
      ],
      "kv_namespaces": [
        {
          "binding": "SCENES",
          "id": "07dcdd515d524614b1d3e2ff0c2faa3a"
        }
      ]
    }
  }
}
